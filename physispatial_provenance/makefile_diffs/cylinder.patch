 list-user-projects:
 	@echo "user projects::"
 	@cd ./user_projects && ls -dt1 * | grep . | sed 's!empty.txt!!'
+
+# PhysiSpatial: offline, bundled MaBoSS build; does not call the download helper.
+MABOSS_STATIC := $(MABOSS_DIR)/lib/libMaBoSS_$(MABOSS_MAX_NODES)n-static.a
+all static: $(MABOSS_STATIC)
+$(MABOSS_STATIC):
+	touch $(MABOSS_DIR)/src/depend.mk
+	$(MAKE) -C $(MABOSS_DIR)/src -f Makefile.maboss MAXNODES=$(MABOSS_MAX_NODES) CXX=$(CC) init
+	$(MAKE) -C $(MABOSS_DIR)/src -f Makefile.maboss MAXNODES=$(MABOSS_MAX_NODES) CXX=$(CC) libMaBoSS_$(MABOSS_MAX_NODES)n-static.a
+	mkdir -p $(MABOSS_DIR)/lib
+	cp $(MABOSS_DIR)/src/libMaBoSS_$(MABOSS_MAX_NODES)n-static.a $@
+
+-include physispatial_tools/projects.mk
+
+# Historical-source objects must never leak into a subsequently loaded upstream sample.
+reset: clean
