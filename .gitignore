# --- Upstream PhysiCell/PhysiBoSS (anchored to the root so that sample
# --- projects such as sample_projects/biorobots are NOT ignored) ---
*.asv
._.DS_Store
.DS_Store
*.exe
*.o
/addons/libRoadrunner/roadrunner/
/addons/libRoadrunner/roadrunner-win64-vs14-cp35m.zip
/addons/PhysiBoSS/libMaBoSS-*.tar.gz
/biorobots
/cancer_immune_3D
/heterogeneity
/interaction_demo
/project
/config/PhysiCell_settings-backup.xml
/initial.svg
/Makefile-backup
pmb_debug.log
studio_debug.log
/user_projects/*
!/user_projects/empty.txt
.vscode
*.tar.gz

# --- PhysiSpatial: bundled MaBoSS SOURCE is tracked; build products are not ---
/addons/PhysiBoSS/MaBoSS/engine/lib/
/addons/PhysiBoSS/MaBoSS/engine/src/*.o
/addons/PhysiBoSS/MaBoSS/engine/src/*.a
/addons/PhysiBoSS/MaBoSS/engine/src/*.so
/addons/PhysiBoSS/MaBoSS/engine/src/depend.mk
/addons/PhysiBoSS/MaBoSS/engine/src/MaBoSS_256n
/addons/PhysiBoSS/MaBoSS/engine/src/PopMaBoSS_256n
/addons/PhysiBoSS/MaBoSS/engine/src/lex.*.cc
/addons/PhysiBoSS/MaBoSS/engine/src/*Grammar.cc
/addons/PhysiBoSS/MaBoSS/engine/src/*Grammar.tab.*
/addons/PhysiBoSS/MaBoSS/engine/src/*Grammar.output
/addons/PhysiBoSS/MaBoSS/engine/src/*.gch
/addons/PhysiBoSS/MaBoSS/engine/src/maboss-config.h

# Files copied to the root by `make physispatial-<geometry>` (the active
# project). The root Makefile and config/PhysiCell_settings.xml are tracked
# upstream files: run `make reset` before committing so they are not changed.
/main.cpp
/custom_modules/*
!/custom_modules/empty.txt
/config/*
!/config/PhysiCell_settings.xml

# Executables and per-user working/run directories
/physispatial_prism
/physispatial_cylinder
/physispatial_sphere
/physispatial_work/
/physispatial_runs/
/output_*/
__pycache__/
*.pyc

# TNFalpha RNG seeding fix validation: keep scripts/evidence/summaries,
# not the scratch simulation outputs they produce.
/physispatial_validation/tnfalpha_rng/runs/
/physispatial_validation/tnfalpha_rng/check6_runs/
/physispatial_validation/tnfalpha_rng/check6_batch.log
